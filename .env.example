
# ─────────────────────────────────────────────────────────────────────────────
# OBLIGATORIOS

# ─────────────────────────────────────────────────────────────────────────────

HIVE_PUBLIC_URL=


HIVE_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# PIPER TTS - Calidad de voz
# ─────────────────────────────────────────────────────────────────────────────
# Parámetros de inferencia para mejorar la naturalidad del audio
# Valores por defecto ya están optimizados, pero puedes ajustarlos aquí

# Controla la velocidad del habla (0.8-1.2)
# Menor = más lento y natural, Mayor = más rápido
PIPER_LENGTH_SCALE=0.95

# Controla la variación en duración de fonemas (0.5-0.8)
# Menor = más consistente, Mayor = más variación
PIPER_NOISE_SCALE=0.6

# Controla la variación en el sonido (0.6-0.9)
# Menor = más suave, Mayor = más expresivo
PIPER_NOISE_W=0.75

# Silencio entre frases en segundos (0.1-0.5)
# Añade pausas naturales para mejor comprensión
PIPER_SENTENCE_SILENCE=0.2

# Voz por defecto para Piper TTS (se usa si el canal no tiene una voz específica)
# Disponibles: es_MX-claude-14947-epoch-high, es_MX-cortana-19669-epoch-high, es_MX-gevy-10196-epoch-high
TTS_VOICE=es_MX-claude-14947-epoch-high
