# Hive - Variables de entorno opcionales
# Copia este archivo como .env y ajusta según tus necesidades

# ─────────────────────────────────────────────────────────────────────────────
# ACCESO A ARCHIVOS DEL HOST (Docker)
# ─────────────────────────────────────────────────────────────────────────────
# El agente Hive puede acceder a archivos de tu sistema configurando el 
# workspace en la UI. Este path se monta en /host/home dentro del contenedor.
#
# DESCOMENTA LA LÍNEA DE TU SISTEMA OPERATIVO:

# Linux:
HIVE_HOME_PATH=/home/$USER

# macOS:
# HIVE_HOME_PATH=/Users/$USER

# Windows (PowerShell - Git Bash o WSL):
# HIVE_HOME_PATH=C:/Users/$USER

# Windows (CMD):
# HIVE_HOME_PATH=C:/Users/%USERNAME%

# ─────────────────────────────────────────────────────────────────────────────
# WORKSPACE POR DEFECTO
# ─────────────────────────────────────────────────────────────────────────────
# Directorio workspace por defecto (se usa si no se configura HIVE_HOME_PATH)
# HIVE_WORKSPACE=./workspace

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN DEL SERVIDOR
# ─────────────────────────────────────────────────────────────────────────────
# HIVE_HOST=0.0.0.0
# HIVE_PORT=18790

# ─────────────────────────────────────────────────────────────────────────────
# OPCIONALES
# ─────────────────────────────────────────────────────────────────────────────
# HIVE_LOG_LEVEL=info
# HIVE_AUTH_TOKEN=your-token-here
