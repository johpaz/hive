
# ─────────────────────────────────────────────────────────────────────────────
# OBLIGATORIOS

# ─────────────────────────────────────────────────────────────────────────────

HIVE_PUBLIC_URL=


HIVE_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE — conectar Gmail, Calendar y Drive (opcional; NO es un inicio de sesión)
# ─────────────────────────────────────────────────────────────────────────────
# Son las mismas credenciales OAuth («Aplicación web») de hive-cloud
# (GOOGLE_GMAIL_CLIENT_ID / GOOGLE_GMAIL_CLIENT_SECRET). Sin ellas no hay botón para
# conectar Google y las tools de Gmail/Calendar/Drive no se cargan. Google nunca abre
# sesión en Hive ni activa la protección de acceso: eso solo lo hace la contraseña.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI. Normalmente NO hace falta: se deduce de cada solicitud.
#  · Servidor público: ${HIVE_PUBLIC_URL}/api/google/oauth/callback
#  · localhost / app de escritorio: http://127.0.0.1:<puerto>/api/google/oauth/callback
#    (el puerto es 18790 o uno libre si está ocupado).
# Cliente OAuth de tipo «Aplicación web»: registra cada URI exacto en Google Cloud
#   Console (no admite comodines de puerto).
# Cliente OAuth de tipo «Aplicación de escritorio»: acepta cualquier puerto de
#   loopback sin registrarlo; es el indicado para la app de escritorio y localhost.
#GOOGLE_REDIRECT_URI=

# Servicios que se pueden conectar, separados por coma (por defecto: todos).
#GOOGLE_SCOPES=gmail,calendar,drive

# ─────────────────────────────────────────────────────────────────────────────
# PIPER TTS - Calidad de voz
# ─────────────────────────────────────────────────────────────────────────────
# Parámetros de inferencia para mejorar la naturalidad del audio
# Valores por defecto ya están optimizados, pero puedes ajustarlos aquí

# Controla la velocidad del habla (0.8-1.2)
# Menor = más lento y natural, Mayor = más rápido
PIPER_LENGTH_SCALE=0.95

# Controla la variación en duración de fonemas (0.5-0.8)
# Menor = más consistente, Mayor = más variación
PIPER_NOISE_SCALE=0.6

# Controla la variación en el sonido (0.6-0.9)
# Menor = más suave, Mayor = más expresivo
PIPER_NOISE_W=0.75

# Silencio entre frases en segundos (0.1-0.5)
# Añade pausas naturales para mejor comprensión
PIPER_SENTENCE_SILENCE=0.2

# Voz por defecto para Piper TTS (se usa si el canal no tiene una voz específica)
# Disponibles: es_MX-claude-14947-epoch-high, es_MX-cortana-19669-epoch-high, es_MX-gevy-10196-epoch-high
TTS_VOICE=es_MX-claude-14947-epoch-high
