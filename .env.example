# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN DEL SERVIDOR
# ─────────────────────────────────────────────────────────────────────────────
HIVE_HOST=0.0.0.0
HIVE_PORT=18790

# ─────────────────────────────────────────────────────────────────────────────
# OPCIONALES
# ─────────────────────────────────────────────────────────────────────────────
HIVE_LOG_LEVEL=info

# Token de autenticación. Si no se define, se genera automáticamente durante
# el setup y se guarda en ~/.hive/.env con el userId del usuario creado.
# Solo es necesario definirlo aquí si quieres sobreescribir el generado.
# HIVE_AUTH_TOKEN=your-token-here
