{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@johpaz/hive-core": [
        "./packages/core/src/index.ts"
      ],
      "@johpaz/hive-core/*": [
        "./packages/core/src/*"
      ],
      "@johpaz/hive-mcp": [
        "./packages/mcp/src/index.ts"
      ],
      "@johpaz/hive-mcp/*": [
        "./packages/mcp/src/*"
      ],
      "@johpaz/hive-skills": [
        "./packages/skills/src/index.ts"
      ],
      "@johpaz/hive-skills/*": [
        "./packages/skills/src/*"
      ],
      "@johpaz/hive-cli": [
        "./packages/cli/src/index.ts"
      ],
      "@johpaz/hive-code-bridge": [
        "./packages/code-bridge/src/index.ts"
      ],
      "@johpaz/hive-code-bridge/*": [
        "./packages/code-bridge/src/*"
      ],
      "@johpaz/hive-tools": [
        "./packages/tools/src/index.ts"
      ],
      "@johpaz/hive-tools/*": [
        "./packages/tools/src/*"
      ],
      "@/*": [
        "./packages/hive-ui/src/*"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/hive-ui/src/**/*",
    "tests/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}